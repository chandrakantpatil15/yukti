          "auto_scaling_group": "prod-app-asg",
          "instances": ["i-0ef1234ghi567890d"],
          "security_groups": ["sg-0bcd234efg567890b"],
          "subnet_ids": ["subnet-0cde345fgh678901c", "subnet-0def456ghi789012d"]
        },
        "data_tier": {
          "primary_db": {
