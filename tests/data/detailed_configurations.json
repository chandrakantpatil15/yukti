            "instances": ["db-0abc123def456789a", "db-0bcd234efg567890b"],
            "subnet_group": "prod-db-subnet",
            "security_groups": ["sg-0cde345fgh678901c"]
          },
          "cache": {
            "cluster": "prod-redis-01",
            "nodes": ["node-0abc123def456789a", "node-0bcd234efg567890b"],
            "subnet_group": "prod-cache-subnet",
            "security_groups": ["sg-0def456ghi789012d"]
          }
        }
      }
    }
  },
