{
  "service_configurations": {
    "eks": {
      "clusters": {
        "prod-k8s-01": {
          "addons": [
            {
              "name": "aws-ebs-csi-driver",
              "version": "v1.25.0-eksbuild.1"
            },
            {
              "name": "vpc-cni",
              "version": "v1.12.0-eksbuild.1"
            },
            {
              "name": "kube-proxy",
              "version": "v1.28.1-eksbuild.1"
            },
            {
              "name": "coredns",
              "version": "v1.10.1-eksbuild.1"
            }
          ],
          "logging": {
            "api_server": true,
            "audit": true,
            "authenticator": true,
            "controller_manager": true,
            "scheduler": true
          },
          "network_config": {
            "vpc_id": "vpc-0abc123def456789a",
            "subnet_ids": [
              "subnet-0abc123def456789a",
              "subnet-0bcd234efg567890b"
            ],
            "security_groups": [
              "sg-0abc123def456789a"
            ],
            "cluster_ip_family": "ipv4",
            "service_ipv4_cidr": "172.20.0.0/16"
          }
        }
      }
    },
    "rds": {
      "parameter_groups": {
        "prod-postgres-14": {
          "family": "postgres14",
          "parameters": {
            "max_connections": "1000",
            "shared_buffers": "8GB",
            "effective_cache_size": "24GB",
            "maintenance_work_mem": "2GB",
            "checkpoint_completion_target": "0.9",
            "wal_buffers": "16MB",
            "default_statistics_target": "100",
            "random_page_cost": "1.1",
            "effective_io_concurrency": "200",
            "work_mem": "20971kB",
            "min_wal_size": "2GB",
            "max_wal_size": "8GB"
          }
        }
      },
      "option_groups": {
        "prod-mysql-8": {
          "family": "mysql8.0",
          "options": [
            {
              "name": "MEMCACHED",
              "settings": {
                "CHUNK_SIZE": "32",
                "MAX_CONNECTIONS": "2000"
              }
            },
            {
              "name": "MARIADB_AUDIT_PLUGIN",
              "settings": {
                "SERVER_AUDIT_EVENTS": "CONNECT,QUERY,TABLE"
              }
            }
          ]
        }
      }
    },
    "elasticache": {
      "parameter_groups": {
        "prod-redis-6": {
          "family": "redis6.x",
          "parameters": {
            "maxmemory-policy": "volatile-lru",
            "timeout": "300",
            "notify-keyspace-events": "AKE",
            "maxmemory-samples": "10"
          }
        }
      }
    }
  },
  "monitoring_metrics": {
    "ec2_enhanced": {
      "memory": {
        "mem_used_percent": {
          "unit": "Percent",
          "period": 60,
          "statistics": ["Average", "Maximum", "Minimum"]
        },
        "mem_available": {
          "unit": "Bytes",
          "period": 60,
          "statistics": ["Average"]
        },
        "swap_used": {
          "unit": "Bytes",
          "period": 60,
          "statistics": ["Average", "Maximum"]
        }
      },
      "disk": {
        "disk_used_percent": {
          "unit": "Percent",
          "period": 60,
          "statistics": ["Average", "Maximum"]
        },
        "disk_io_reads": {
          "unit": "Count/Second",
          "period": 60,
          "statistics": ["Average", "Maximum", "Sum"]
        },
        "disk_io_writes": {
          "unit": "Count/Second",
          "period": 60,
          "statistics": ["Average", "Maximum", "Sum"]
        }
      },
      "network": {
        "net_packet_drops": {
          "unit": "Count",
          "period": 60,
          "statistics": ["Sum"]
        },
        "net_tcp_established": {
          "unit": "Count",
          "period": 60,
          "statistics": ["Average"]
        }
      }
    },
    "rds_enhanced": {
      "os": {
        "cpuUtilization": {
          "user": {
            "unit": "Percent",
            "period": 60,
            "statistics": ["Average", "Maximum"]
          },
          "system": {
            "unit": "Percent",
            "period": 60,
            "statistics": ["Average", "Maximum"]
          },
          "wait": {
            "unit": "Percent",
            "period": 60,
            "statistics": ["Average", "Maximum"]
          }
        },
        "processlist": {
          "blockedTransactions": {
            "unit": "Count",
            "period": 60,
            "statistics": ["Average", "Maximum"]
          },
          "cpuUtilization": {
            "unit": "Percent",
            "period": 60,
            "statistics": ["Average", "Maximum"]
          }
        }
      }
    }
  },
  "resource_relationships": {
    "tenant1": {
      "application_stack": {
        "web_tier": {
          "load_balancer": "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/prod-web/abc123",
